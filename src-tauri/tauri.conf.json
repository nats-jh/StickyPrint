{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "StickyPrint",
  "version": "1.0.3",
  "identifier": "com.kangjoonhyuk.stickyprint",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "node scripts/build-dist.mjs",
    "beforeBuildCommand": "node scripts/build-dist.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "StickyPrint",
        "width": 1440,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQwNTYwMzc5MTJFNkFFMDAKUldRQXJ1WVNlUU5XUUNzT0Vmb1R1YjJFaFlJdTdRWHJoUUtQS1gxWE9XYkd1cGlXakVDaGZRUWcK",
      "endpoints": [
        "https://github.com/nats-jh/StickyPrint/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "kangjoonhyuk",
    "copyright": "© 2026 kangjoonhyuk",
    "shortDescription": "포스트잇 인쇄 도우미",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["Korean"],
        "installMode": "currentUser",
        "installerIcon": "installer/installer.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "uninstallerIcon": "installer/uninstaller.ico",
        "uninstallerHeaderImage": "installer/header.bmp"
      }
    }
  }
}
